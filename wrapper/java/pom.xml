<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.snower</groupId>
  <artifactId>ruslock</artifactId>
  <version>1.1.5</version>
  <packaging>jar</packaging>

  <name>RusLock Java 8 binding</name>
  <description>Jaslock-compatible Java 8 API backed by the RusLock Rust primitives.</description>
  <url>https://github.com/snower/ruslock</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <junit.version>4.13.2</junit.version>

    <!-- Contract with wrapper/java/native/Cargo.toml: [lib] name = "ruslock_java". -->
    <ruslock.native.buildDir>${project.build.directory}/native</ruslock.native.buildDir>

    <!-- Set to false only by the platform profile for the machine that is building. -->
    <ruslock.native.bundle.skip>true</ruslock.native.bundle.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.3.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-jaslock-license</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>LICENSE-JASLOCK</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
            </manifest>
            <manifestEntries>
              <Implementation-Title>io.github.snower:ruslock</Implementation-Title>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>bundle-ruslock-native</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${ruslock.native.bundle.skip}</skip>
              <target>
                <copy file="${ruslock.native.buildDir}/release/${ruslock.native.fileName}"
                      todir="${project.build.outputDirectory}/io/github/snower/jaslock/native/${ruslock.native.platform}"
                      failonerror="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Native profiles are opt-in by construction: they are inactive until the JNI crate exists at
      wrapper/java/native/Cargo.toml. The build always requires the committed Cargo.lock, writes
      to target/native, and bundles only the platform that is currently building. A JAR built
      without a native artifact is still valid Java, but NativeLibrary reports the missing
      resource for the running platform instead of falling back to java.library.path.
    -->
    <profile>
      <id>native-build</id>
      <activation>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>build-ruslock-jni</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>cargo</executable>
                  <workingDirectory>${project.basedir}/native</workingDirectory>
                  <arguments>
                    <argument>build</argument>
                    <argument>--locked</argument>
                    <argument>--release</argument>
                    <argument>--manifest-path</argument>
                    <argument>${project.basedir}/native/Cargo.toml</argument>
                    <argument>--target-dir</argument>
                    <argument>${ruslock.native.buildDir}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>native-bundle-windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>windows-x86_64</ruslock.native.platform>
        <ruslock.native.fileName>ruslock_java.dll</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-windows-x86_64-alt</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>x86_64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>windows-x86_64</ruslock.native.platform>
        <ruslock.native.fileName>ruslock_java.dll</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-linux-x86_64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>linux-x86_64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.so</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-linux-x86_64-alt</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>x86_64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>linux-x86_64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.so</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-linux-aarch64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>aarch64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>linux-aarch64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.so</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-macos-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>macos-x86_64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.dylib</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-macos-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>macos-aarch64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.dylib</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>

    <profile>
      <id>native-bundle-macos-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>arm64</arch>
        </os>
        <file>
          <exists>native/Cargo.toml</exists>
        </file>
      </activation>
      <properties>
        <ruslock.native.platform>macos-aarch64</ruslock.native.platform>
        <ruslock.native.fileName>libruslock_java.dylib</ruslock.native.fileName>
        <ruslock.native.bundle.skip>false</ruslock.native.bundle.skip>
      </properties>
    </profile>
  </profiles>
</project>
